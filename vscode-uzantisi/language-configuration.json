{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(eğer|değilse|yoksa|iken|için|fonksiyon|sınıf|dene|hariç|sonunda|ile|eşzamansız).*:\\s*$",
    "decreaseIndentPattern": "^\\s*(değilse|yoksa|hariç|sonunda).*:\\s*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#.*region",
      "end": "^\\s*#.*endregion"
    }
  }
}
