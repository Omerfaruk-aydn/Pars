# API İstekleri

içe_aktar urllib.request
içe_aktar json
içe_aktar os

# Ağ erişimi olmayan ortamlarda örnek atlanır
eğer os.environ.get("PARS_ORNEK_AG") != "1":
    yaz("Ağ örnekleri atlandı. Çalıştırmak için: PARS_ORNEK_AG=1")
    cikis()

# 1. Basit GET isteği
yaz("=== Basit GET İsteği ===")
dene:
    url = "https://jsonplaceholder.typicode.com/posts/1"
    yanit = urllib.request.urlopen(url, timeout=10)
    veri = json.loads(yanit.read().decode('utf-8'))

    yaz(f"Başlık: {veri['title']}")
    yaz(f"Gövde: {veri['body'][:100]}...")
hariç Hata olarak e:
    yaz(f"İstek hatası: {e}")

# 2. Birden fazla istek
yaz("\n=== Çoklu İstekler ===")
dene:
    url = "https://jsonplaceholder.typicode.com/posts"
    yanit = urllib.request.urlopen(url, timeout=10)
    gönderiler = json.loads(yanit.read().decode('utf-8'))

    yaz(f"Toplam gönderi sayısı: {uzunluk(gönderiler)}")
    yaz("\nİlk 5 gönderi:")
    için i, gönderi içinde enumerate(gönderiler[:5]):
        yaz(f"  {i+1}. {gönderiler[i]['title'][:50]}")
hariç Hata olarak e:
    yaz(f"İstek hatası: {e}")

# 3. Kullanıcı bilgileri
yaz("\n=== Kullanıcılar ===")
dene:
    url = "https://jsonplaceholder.typicode.com/users"
    yanit = urllib.request.urlopen(url, timeout=10)
    kullanıcılar = json.loads(yanit.read().decode('utf-8'))

    için kullanıcı içinde kullanıcılar[:3]:
        yaz(f"\n  Ad: {kullanıcı['name']}")
        yaz(f"  Email: {kullanıcı['email']}")
        yaz(f"  Şehir: {kullanıcı['address']['city']}")
        yaz(f"  Website: {kullanıcı['website']}")
hariç Hata olarak e:
    yaz(f"İstek hatası: {e}")

# 4. POST isteği
yaz("\n=== POST İsteği ===")
dene:
    url = "https://jsonplaceholder.typicode.com/posts"
    veri = json.dumps({
        "title": "PARS Test",
        "body": "Bu bir PARS test gönderisidir",
        "userId": 1
    }).encode('utf-8')

    istek = urllib.request.Request(url, data=veri, method='POST')
    istek.add_header('Content-Type', 'application/json')

    yanit = urllib.request.urlopen(istek, timeout=10)
    sonuç = json.loads(yanit.read().decode('utf-8'))

    yaz(f"Durum kodu: {yanit.status}")
    yaz(f"Oluşturulan ID: {sonuç['id']}")
    yaz(f"Başlık: {sonuç['title']}")
hariç Hata olarak e:
    yaz(f"İstek hatası: {e}")

# 5. URL kodlama
yaz("\n=== URL Kodlama ===")
parametreler = {
    "q": "Python programlama",
    "lang": "tr",
    "page": 1
}
kodlanmış = urllib.parse.urlencode(parametreler)
yaz(f"Kodlanmış URL: {kodlenmiş}")

# 6. Başlıklar ile istek
yaz("\n=== Özel Başlıklar ===")
dene:
    url = "https://httpbin.org/headers"
    istek = urllib.request.Request(url)
    istek.add_header('User-Agent', 'PARS/1.0')
    istek.add_header('Accept', 'application/json')
    istek.add_header('X-Custom', 'PARS-Test')

    yanit = urllib.request.urlopen(istek, timeout=10)
    başlıklar = json.loads(yanit.read().decode('utf-8'))

    yaz("Gönderilen başlıklar:")
    için anahtar, değer içinde başlıklar['headers'].items():
        yaz(f"  {anahtar}: {değer}")
hariç Hata olarak e:
    yaz(f"İstek hatası: {e}")

yaz("\nAPI istekleri örnekleri tamamlandı!")
